{
  "version": 8,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "host",
      "displayName": "Host tests & tools",
      "binaryDir": "${sourceDir}/Build/host",
      "cacheVariables": { "TOYOS_HOST": "ON" }
    },
    {
      "name": "aarch64",
      "displayName": "aarch64 target (kernel + userspace)",
      "binaryDir": "${sourceDir}/Build/aarch64",
      "toolchainFile": "${sourceDir}/cmake/aarch64-toolchain.cmake"
    }
  ],
  "buildPresets": [
    { "name": "host", "configurePreset": "host" },
    { "name": "aarch64", "configurePreset": "aarch64" }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "output": { "outputOnFailure": true }
    }
  ]
}
